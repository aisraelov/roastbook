node_modules/
npm-debug.*
yarn-debug.log*
yarn-error.log*
*.log

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native iOS (generated by `npx expo prebuild`; uncomment subpaths below if
