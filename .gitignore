# ios/build/
# ios/DerivedData/
# ios/*.xcworkspace/xcuserdata/
# ios/*.xcodeproj/xcuserdata/
# ios/.xcode.env.local
# android/build/
# android/.gradle/
# android/app/build/
# android/local.properties

# Metro / Hermes / Reanimated
metro-cache/
.haste_cache/
.metro-health-check*

# Maestro screenshots (regenerate on every test run)
maestro/screenshots/*.png

# Misc IDE / OS
*.tsbuildinfo
.idea/
.vscode/
Thumbs.db
